{
  "manifest_version": 3,
  "name": "issa",
  "version": "0.3.0",
  "description": "Likes, bookmarks and replies to posts on X, and answers comments under your own posts, with bounded automatic mode.",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1:8642/*",
    "http://localhost:8642/*",
    "https://openrouter.ai/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "issa", "default_popup": "src/options.html" },
  "options_page": "src/options.html",
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["src/domain.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}
